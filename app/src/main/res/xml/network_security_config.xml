<?xml version="1.0" encoding="utf-8"?>
<!-- All network traffic must use HTTPS; only the system certificate store is trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
